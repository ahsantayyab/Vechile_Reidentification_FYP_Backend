# Detector settings
DETECTOR_BACKEND=yolo
DETECTION_CONFIDENCE=0.4
DETECTION_IOU_THRESHOLD=0.5
DETECTION_CLASS_IDS=[2,3,5,7]
DETECTION_MAX_DETECTIONS=50
DETECTION_MIN_BOX_SIZE=30

# Processing settings
FRAME_SAMPLING_STRIDE=5
MAX_FRAMES_PER_JOB=500
ML_BATCH_SIZE=8
ML_DEVICE=auto
